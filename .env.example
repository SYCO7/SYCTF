# SYCTF AI configuration — copy to .env (gitignored) and fill what you use.
# You only need ONE backend. Local Ollama needs no key. Hosted providers need
# their own key. "Bring any key" — set the provider + model + its key env.

# ---- pick the active backend -------------------------------------------------
# provider: ollama | anthropic | openai | gemini | groq | nvidia | openrouter |
#           deepseek | mistral | together | fireworks | cerebras | xai |
#           perplexity | sambanova | lmstudio | vllm
SYCTF_AI_PROVIDER=ollama
SYCTF_AI_MODEL=qwen2.5:7b-instruct-q4_K_M

# Optional per-tier overrides (cheap routing model, coder model)
# SYCTF_AI_ROUTE_PROVIDER=ollama
# SYCTF_AI_ROUTE_MODEL=qwen2.5:3b-instruct-q4_K_M
# SYCTF_AI_CODE_PROVIDER=ollama
# SYCTF_AI_CODE_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

# Local fallback used automatically when a hosted provider errors/offline
SYCTF_AI_FALLBACK_PROVIDER=ollama
SYCTF_AI_FALLBACK_MODEL=qwen2.5:7b-instruct-q4_K_M

# Behaviour knobs
SYCTF_AI_TEMPERATURE=0.2
SYCTF_AI_ENSEMBLE=1        # >1 = self-consistency voting (anti-hallucination)
SYCTF_AI_VERIFY=1         # 1 = grounding/verification guards on
SYCTF_AI_OFFLINE=0        # 1 = never call hosted providers (air-gapped CTF)

# ---- API keys (set only the ones you use) -----------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=
# SAMBANOVA_API_KEY=

# ---- optional endpoint overrides (self-hosted / proxies) --------------------
# SYCTF_OPENAI_BASE_URL=https://api.openai.com/v1
# SYCTF_OLLAMA_TIMEOUT=120
